{
  "extends": "../../tsconfig.json",
  // Specifies a list of type declarations to be included in auto type acquisition. Ex. ["jquery", "lodash"]
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../style/**/*.ts",
    "../utils/**/*.ts",
    "../utils/**/*.tsx"
  ],
  "compilerOptions": {
    "composite": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@": ["./src"],
      "@/*": ["./src/*"]
    }
  }
}
